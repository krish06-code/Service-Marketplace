PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/serviconnect?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
UPLOAD_PATH=uploads

# Firebase Admin SDK Configuration (Choose one of the two options)
# Option 1: Minified single-line JSON of service account private key (e.g. {"type":"service_account",...})
FIREBASE_SERVICE_ACCOUNT=
# Option 2: Path to downloaded serviceAccountKey.json file
# GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json
